{"version":3,"file":"combobox-trigger.js","names":["BaseCombobox","ComboboxTriggerElement"],"sources":["../../../src/components/combobox/combobox-trigger.tsx"],"sourcesContent":["import { Combobox as BaseCombobox } from \"@base-ui/react/combobox\";\nimport { ChevronDown } from \"lucide-react\";\nimport type * as React from \"react\";\n\nimport {\n  type ComboboxSize,\n  type ComboboxVariant,\n  ComboboxTrigger as ComboboxTriggerElement,\n  ComboboxValue,\n} from \"../../elements/combobox\";\nimport { Icon } from \"../../internal/icon\";\n\nexport type ComboboxTriggerProps = Omit<\n  BaseCombobox.Trigger.Props,\n  \"children\" | \"className\" | \"style\" | \"render\"\n> & {\n  /**\n   * Frame look. `neutral` is the bordered field surface; `ghost` is borderless. Invalid on ghost\n   * has no trigger chrome — the danger cue is the helper text below.\n   *\n   * @default \"neutral\"\n   */\n  variant?: ComboboxVariant;\n  /** Visual size of the trigger: height, text, and glyph sizing. Required. */\n  size: ComboboxSize;\n  /** Shown in the trigger while nothing is selected — Base UI's `Combobox.Value` placeholder. */\n  placeholder?: React.ReactNode;\n  /** Decorative leading element at the inline-start, e.g. `<Icon icon={Plus} tint=\"placeholder\" />`. */\n  icon?: React.ReactNode;\n  /**\n   * Decorative trailing glyph. Omit it to show a chevron (the Figma end node). This is not a nested\n   * popup-trigger control — the frame itself is the `Trigger`.\n   */\n  trailing?: React.ReactNode;\n};\n\n/**\n * The ready-made closed-field trigger: grafts Base UI's `Trigger` onto the styled frame and shows\n * the selected value (or `placeholder`) plus a trailing chevron. Use this instead of\n * `ComboboxInputGroup` when the filter input lives in the panel (`ComboboxSearch`).\n */\nexport function ComboboxTrigger({\n  size,\n  variant,\n  placeholder,\n  icon,\n  trailing,\n  ...props\n}: ComboboxTriggerProps) {\n  return (\n    <BaseCombobox.Trigger\n      {...props}\n      render={<ComboboxTriggerElement size={size} variant={variant} />}\n    >\n      {icon}\n      <ComboboxValue>\n        <BaseCombobox.Value placeholder={placeholder} />\n      </ComboboxValue>\n      {trailing ?? (\n        <Icon tint=\"secondary\">\n          <ChevronDown aria-hidden />\n        </Icon>\n      )}\n    </BaseCombobox.Trigger>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;AAyCA,SAAgB,gBAAgB,EAC9B,MACA,SACA,aACA,MACA,UACA,GAAG,SACoB;CACvB,OACE,qBAACA,SAAa,SAAd;EACE,GAAI;EACJ,QAAQ,oBAACC,mBAAD;GAA8B;GAAe;EAAU,CAAA;EAFjE,UAAA;GAIG;GACD,oBAAC,eAAD,EAAA,UACE,oBAACD,SAAa,OAAd,EAAiC,YAAc,CAAA,EAClC,CAAA;GACd,YACC,oBAAC,MAAD;IAAM,MAAK;IACT,UAAA,oBAAC,aAAD,EAAa,eAAA,KAAa,CAAA;GACtB,CAAA;EAEY;;AAE1B"}