{"version":3,"file":"select-item.js","names":["BaseSelect"],"sources":["../../../src/components/select/select-item.tsx"],"sourcesContent":["import { Select as BaseSelect } from \"@base-ui/react/select\";\nimport { Check } from \"lucide-react\";\n\nimport { SelectItemIndicator } from \"../../elements/select\";\nimport { ListboxItem, type ListboxItemSize } from \"../../internal/listbox-item\";\n\nexport type SelectItemProps = Omit<\n  BaseSelect.Item.Props,\n  \"children\" | \"className\" | \"label\" | \"render\" | \"style\"\n> & {\n  /** Visual size of the row: controls its height and text size. Required. */\n  size: ListboxItemSize;\n  /** Option label. */\n  label: string;\n};\n\n/**\n * The ready-made select option row: grafts Base UI's `Select.Item` behavior onto the shared listbox\n * row and bakes the selection marker — Base UI's `Select.ItemIndicator` grafted onto the styled\n * `SelectItemIndicator` with a check glyph, at the row's inline-END (a single-select check trails\n * its label; only a multi-select checkbox leads). The marker is `keepMounted` because the\n * `layout=\"indicator\"` row places children positionally: it must occupy the trailing column even\n * while unselected (the styled marker hides its glyph off `data-selected`). The `label` prop\n * becomes the item's text via Base UI's `Select.ItemText`.\n */\nexport function SelectItem({ label, size, ...props }: SelectItemProps) {\n  return (\n    <BaseSelect.Item {...props} render={<ListboxItem layout=\"indicator\" size={size} />}>\n      <BaseSelect.ItemText>{label}</BaseSelect.ItemText>\n      <BaseSelect.ItemIndicator keepMounted render={<SelectItemIndicator />}>\n        <Check aria-hidden />\n      </BaseSelect.ItemIndicator>\n    </BaseSelect.Item>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;;;AAyBA,SAAgB,WAAW,EAAE,OAAO,MAAM,GAAG,SAA0B;CACrE,OACE,qBAACA,OAAW,MAAZ;EAAiB,GAAI;EAAO,QAAQ,oBAAC,aAAD;GAAa,QAAO;GAAkB;EAAO,CAAA;EAAjF,UAAA,CACE,oBAACA,OAAW,UAAZ,EAAA,UAAsB,MAA2B,CAAA,GACjD,oBAACA,OAAW,eAAZ;GAA0B,aAAA;GAAY,QAAQ,oBAAC,qBAAD,CAAsB,CAAA;GAClE,UAAA,oBAAC,OAAD,EAAO,eAAA,KAAa,CAAA;EACI,CAAA,CACX;;AAErB"}