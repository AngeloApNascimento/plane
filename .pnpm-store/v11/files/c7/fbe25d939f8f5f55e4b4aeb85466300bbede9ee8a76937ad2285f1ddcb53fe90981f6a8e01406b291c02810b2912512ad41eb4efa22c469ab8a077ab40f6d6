{"version":3,"file":"menu-submenu-content.js","names":[],"sources":["../../../src/components/menu/menu-submenu-content.tsx"],"sourcesContent":["import { MenuContentSurface, type MenuSurfaceProps } from \"./menu-content.shared\";\n\nexport type MenuSubmenuContentProps = Omit<MenuSurfaceProps, \"side\" | \"sizing\"> & {\n  /** Which side of the parent row the submenu opens toward. @default \"right\" */\n  side?: MenuSurfaceProps[\"side\"];\n  /**\n   * How the submenu popup takes its width — the same rule as `MenuContent`: `auto` is the content's\n   * width between the 192px floor and the 384px ceiling, held while open; `anchor` matches the\n   * parent row's width.\n   *\n   * @default \"auto\"\n   */\n  sizing?: MenuSurfaceProps[\"sizing\"];\n};\n\n/**\n * The floating surface for a submenu — the same elevated, scrollable panel as `MenuContent`, but\n * anchored beside its parent row instead of below a trigger. Place it inside a `MenuSubmenu`,\n * alongside the `MenuSubmenuTrigger` that opens it.\n */\nexport function MenuSubmenuContent({\n  side = \"right\",\n  sideOffset = 4,\n  align = \"start\",\n  sizing = \"auto\",\n  ...props\n}: MenuSubmenuContentProps) {\n  return (\n    <MenuContentSurface\n      side={side}\n      sideOffset={sideOffset}\n      align={align}\n      sizing={sizing}\n      {...props}\n    />\n  );\n}\n"],"mappings":";;;;;;;;;AAoBA,SAAgB,mBAAmB,EACjC,OAAO,SACP,aAAa,GACb,QAAQ,SACR,SAAS,QACT,GAAG,SACuB;CAC1B,OACE,oBAAC,oBAAD;EACQ;EACM;EACL;EACC;EACR,GAAI;CACL,CAAA;AAEL"}