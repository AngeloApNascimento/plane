\"span\"> = {\n    \"aria-hidden\": true,\n    className: iconVariants({ tint, size }),\n  };\n  return useRender({ defaultTagName: \"span\", render, props: mergeProps(defaultProps, props) });\n}\n"],"mappings":";;;;;AAyBA,MAAa,eAAe,IAAI,eAAe;CAC7C,UAAU;EACR,MAAM;GACJ,SAAS;GACT,QAAQ;GAOR,aAAa,GACX,2CACA,kDACA,iGACF;GACA,OAAO;GACP,WAAW,GACT,uBACA,iGACF;GACA,UAAU;EACZ;EAKA,MAAM;GACJ,SAAS;GACT,IAAI;GACJ,IAAI;GACJ,IAAI;GACJ,IAAI;GACJ,IAAI;GACJ,OAAO;EACT;CACF;CACA,iBAAiB;EAzCjB,MAAM;EACN,MAAM;CAwCW;AACnB,CAAC;AAcD,SAAgB,KAAK,EAAE,MAAM,MAAM,QAAQ,GAAG,SAAoB;CAKhE,OAAO,UAAU;EAAE,gBAAgB;EAAQ;EAAQ,OAAO,WAAW;GAHnE,eAAe;GACf,WAAW,aAAa;IAAE;IAAM;GAAK,CAAC;EAEwC,GAAG,KAAK;CAAE,CAAC;AAC7F"}