aginationPageButton>\n            </PaginationItem>\n          );\n        })}\n\n        <PaginationItem>\n          <PaginationArrowButton\n            aria-label={l.next}\n            disabled={atEnd}\n            onClick={() => onPageChange(page + 1)}\n          >\n            <ArrowRight aria-hidden />\n          </PaginationArrowButton>\n        </PaginationItem>\n      </PaginationList>\n    </PaginationElement>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;AAyCA,SAAS,gBAAgB,MAAc,WAAgC;CAErE,IAAI,aAAa,GACf,OAAO,MAAM,KAAK,EAAE,QAAQ,UAAU,IAAI,GAAG,MAAM,IAAI,CAAC;CAK1D,IAAI,cAAc,OAAO;CACzB,IAAI,YAAY,OAAO;CACvB,IAAI,cAAc,GAAG;EAEnB,cAAc;EACd,YAAY;CACd;CACA,IAAI,YAAY,YAAY,GAAG;EAE7B,YAAY,YAAY;EACxB,cAAc,YAAY;CAC5B;CACA,MAAM,SAAsB,CAAC,CAAC;CAI9B,IAAI,gBAAgB,GAAG,OAAO,KAAK,CAAC;MAC/B,IAAI,cAAc,GAAG,OAAO,KAAK,gBAAgB;CACtD,KAAK,IAAI,IAAI,aAAa,KAAK,WAAW,KAAK,OAAO,KAAK,CAAC;CAG5D,IAAI,cAAc,YAAY,GAAG,OAAO,KAAK,YAAY,CAAC;MACrD,IAAI,YAAY,YAAY,GAAG,OAAO,KAAK,cAAc;CAC9D,OAAO,KAAK,SAAS;CACrB,OAAO;AACT;AAoBA,MAAM,iBAAmC;CACvC,MAAM;CACN,UAAU;CACV,MAAM;CACN,OAAO,SAAS,cAAc;CAC9B,eAAe,aAAa,OAAO,QAAQ;CAC3C,SAAS;AACX;;;;;;;;AAkDA,SAAgB,WAAW,EACzB,MACA,WACA,cACA,UAAU,OACV,UACA,OACA,QACA,GAAG,SACe;CAClB,MAAM,IAAI;EAAE,GAAG;EAAgB,GAAG;CAAO;CACzC,MAAM,SAAS,gBAAgB,MAAM,SAAS;CAC9C,MAAM,UAAU,QAAQ;CACxB,MAAM,QAAQ,QAAQ;CAEtB,OACE,qBAACA,cAAD;EAAmB,cAAY,EAAE;EAAM,GAAI;EAA3C,UAAA;GACG,WACC,qBAAC,mBAAD,EAAA,UAAA,CAQE,qBAACC,QAAD,EAAA,UAAA,CACE,qBAACC,KAAS,SAAV;IACE,QAAQ,oBAAC,0BAAD,CAA2B,CAAA;IACnC,cAAY,GAAG,EAAE,aAAa,SAAS,KAAK,EAAE,GAAG,EAAE;IAFrD,UAAA,CAIG,EAAE,aAAa,SAAS,KAAK,GAC9B,oBAAC,qBAAD;KAAqB,QAAO;KAAO,MAAK;KACtC,UAAA,oBAAC,aAAD,CAAc,CAAA;IACK,CAAA,CACL;GAClB,CAAA,GAAA,oBAAC,aAAD;IAAa,QAAO;IAAS,OAAM;IAChC,UAAA,SAAS,QAAQ,KAAK,WACrB,oBAAC,UAAD;KAEE,OAAO,EAAE,aAAa,MAAM;KAC5B,UAAU,WAAW,SAAS;KAC9B,eAAe,SAAS,cAAc,MAAM;IAC7C,GAJM,MAIN,CACF;GACU,CAAA,CACT,EAAA,CAAA,GACN,oBAAC,wBAAD,EAAA,UAAyB,EAAE,QAAgC,CAAA,CAC1C,EAAA,CAAA,IACjB;GAEH,QACC,qBAAC,iBAAD,EAAA,UAAA;IACE,oBAAC,wBAAD,EAAA,UAAyB,MA