{"version":3,"file":"table-row.js","names":[],"sources":["../../../src/elements/table/table-row.tsx"],"sourcesContent":["import { mergeProps } from \"@base-ui/react/merge-props\";\nimport { useRender } from \"@base-ui/react/use-render\";\n\nimport { type TableRowVariantProps, tableRowVariants } from \"./variants\";\n\nexport type TableRowProps = Omit<useRender.ComponentProps<\"tr\">, \"className\" | \"style\"> &\n  TableRowVariantProps;\n\n/**\n * A table row (`<tr>`). `selected` paints Figma's selected tint and exposes `data-selected` so a\n * pinned cell in this row can follow it; `interactive` marks the row as a click target.\n *\n * `selected` is a visual state only. Pair it with a `TableSelectCell`, whose checkbox carries the\n * real state: a checkbox announces itself, and `aria-multiselectable` is not valid on a plain\n * `table`, so a bare `aria-selected` on the row says less and is easier to leave out of sync.\n */\nexport function TableRow({ selected, interactive, section, render, ...props }: TableRowProps) {\n  const defaultProps: useRender.ElementProps<\"tr\"> = {\n    className: tableRowVariants({ selected, interactive, section }),\n    ...(selected ? { \"data-selected\": \"\" } : {}),\n    ...(section ? { \"data-section\": \"\" } : {}),\n  };\n  return useRender({ defaultTagName: \"tr\", render, props: mergeProps(defaultProps, props) });\n}\n"],"mappings":";;;;;;;;;;;;;AAgBA,SAAgB,SAAS,EAAE,UAAU,aAAa,SAAS,QAAQ,GAAG,SAAwB;CAM5F,OAAO,UAAU;EAAE,gBAAgB;EAAM;EAAQ,OAAO,WAAW;GAJjE,WAAW,iBAAiB;IAAE;IAAU;IAAa;GAAQ,CAAC;GAC9D,GAAI,WAAW,EAAE,iBAAiB,GAAG,IAAI,CAAC;GAC1C,GAAI,UAAU,EAAE,gBAAgB,GAAG,IAAI,CAAC;EAEoC,GAAG,KAAK;CAAE,CAAC;AAC3F"}