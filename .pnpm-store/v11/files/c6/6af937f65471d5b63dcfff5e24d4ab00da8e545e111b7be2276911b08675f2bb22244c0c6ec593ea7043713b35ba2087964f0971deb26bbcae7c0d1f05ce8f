{"version":3,"file":"slider.js","names":["Slider","BaseSlider","SliderElement"],"sources":["../../../src/components/slider/slider.tsx"],"sourcesContent":["import { Slider as BaseSlider } from \"@base-ui/react/slider\";\n\nimport {\n  Slider as SliderElement,\n  SliderControl,\n  SliderHeader,\n  SliderIndicator,\n  SliderLabel,\n  type SliderSize,\n  SliderThumb,\n  SliderTrack,\n  SliderValue,\n} from \"../../elements/slider\";\n\nexport type SliderProps = Omit<BaseSlider.Root.Props<number>, \"className\" | \"style\"> & {\n  /**\n   * Optional visible label rendered above the track (e.g. \"Volume\"). When omitted, provide an\n   * `aria-label` for the thumb so the control is still named for assistive tech.\n   */\n  label?: string;\n  /** Accessible name for the thumb. Required when there is no visible `label`. */\n  \"aria-label\"?: string;\n  /** Thumb and control size. `sm` = 12 px thumb, `md` = 16 px, `lg` = 20 px. */\n  size: SliderSize;\n};\n\n/**\n * The ready-made slider: a single-thumb control for picking a number within a range. Drive it with\n * `value`/`defaultValue` + `onValueChange`, and bound it with `min`/`max`/`step`. Pass `label`\n * (visible) or `aria-label` to name the thumb, and `format` (an `Intl.NumberFormatOptions`) to\n * format the readout.\n *\n * `size` sets the thumb and hit-area size (`sm` / `md` / `lg`). The track bar height and shape are\n * always the same per the design spec.\n *\n * Grafts Base UI `Slider` behavior onto the `elements/slider` styled parts (`Slider` root +\n * `SliderLabel` + `SliderValue` + `SliderControl` + `SliderTrack` + `SliderIndicator` +\n * `SliderThumb`). For multiple thumbs or fully custom layout, graft the `elements/slider` parts\n * directly.\n */\nexport function Slider({ label, \"aria-label\": ariaLabel, size, ...props }: SliderProps) {\n  return (\n    <BaseSlider.Root render={<SliderElement />} {...props}>\n      <SliderHeader>\n        {label == null ? (\n          <span />\n        ) : (\n          <BaseSlider.Label render={<SliderLabel />}>{label}</BaseSlider.Label>\n        )}\n        <BaseSlider.Value render={<SliderValue />} />\n      </SliderHeader>\n      <BaseSlider.Control render={<SliderControl size={size} />}>\n        <BaseSlider.Track render={<SliderTrack />}>\n          <BaseSlider.Indicator render={<SliderIndicator />} />\n          <BaseSlider.Thumb render={<SliderThumb size={size} />} aria-label={ariaLabel} />\n        </BaseSlider.Track>\n      </BaseSlider.Control>\n    </BaseSlider.Root>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;AAwCA,SAAgBA,SAAO,EAAE,OAAO,cAAc,WAAW,MAAM,GAAG,SAAsB;CACtF,OACE,qBAACC,OAAW,MAAZ;EAAiB,QAAQ,oBAACC,UAAD,CAAgB,CAAA;EAAG,GAAI;EAAhD,UAAA,CACE,qBAAC,cAAD,EAAA,UAAA,CACG,SAAS,OACR,oBAAC,QAAD,CAAO,CAAA,IAEP,oBAACD,OAAW,OAAZ;GAAkB,QAAQ,oBAAC,aAAD,CAAc,CAAA;GAAI,UAAA;EAAwB,CAAA,GAEtE,oBAACA,OAAW,OAAZ,EAAkB,QAAQ,oBAAC,aAAD,CAAc,CAAA,EAAI,CAAA,CAChC,EAAA,CAAA,GACd,oBAACA,OAAW,SAAZ;GAAoB,QAAQ,oBAAC,eAAD,EAAqB,KAAO,CAAA;GACtD,UAAA,qBAACA,OAAW,OAAZ;IAAkB,QAAQ,oBAAC,aAAD,CAAc,CAAA;IAAxC,UAAA,CACE,oBAACA,OAAW,WAAZ,EAAsB,QAAQ,oBAAC,iBAAD,CAAkB,CAAA,EAAI,CAAA,GACpD,oBAACA,OAAW,OAAZ;KAAkB,QAAQ,oBAAC,aAAD,EAAmB,KAAO,CAAA;KAAG,cAAY;IAAY,CAAA,CAC/D;;EACA,CAAA,CACL;;AAErB"}