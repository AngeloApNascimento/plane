ant={variant} {...props}>\n      <Glyph />\n    </ToastStatusIconElement>\n  );\n}\n"],"mappings":";;;;;;;;;AAoBA,MAAM,cAAiD;CACrD,SAAS;CACT,QAAQ;CACR,MAAM;CACN,SAAS;CACT,SAAS;AACX;;;;;;AASA,SAAgB,gBAAgB,EAAE,SAAS,GAAG,SAA+B;CAC3E,MAAM,QAAQ,YAAY;CAC1B,OACE,oBAACA,mBAAD;EAAiC;EAAS,GAAI;EAC5C,UAAA,oBAAC,OAAD,CAAQ,CAAA;CACc,CAAA;AAE5B"}