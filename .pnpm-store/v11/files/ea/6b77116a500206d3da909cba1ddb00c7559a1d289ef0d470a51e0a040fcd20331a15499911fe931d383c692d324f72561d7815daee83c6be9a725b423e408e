{"version":3,"file":"checkbox-field.js","names":[],"sources":["../../../src/components/checkbox-field/checkbox-field.tsx"],"sourcesContent":["import type * as React from \"react\";\n\nimport { FieldItemControlGroup } from \"../../elements/field/field-item-control-group\";\nimport type { FieldSize } from \"../../elements/field/variants\";\nimport { Checkbox, type CheckboxProps } from \"../checkbox\";\nimport { Field, FieldItem, FieldItemContent } from \"../field\";\nimport { FieldHelperText } from \"../field/field-helper-text\";\n\nexport type { FieldSize } from \"../../elements/field/variants\";\n\n/** Bare checkbox control props for a field row — no chip `label` / `icon` (Field owns labeling). */\ntype CheckboxFieldControlProps = Omit<CheckboxProps, \"children\" | \"label\" | \"icon\">;\n\nexport type CheckboxFieldProps = Omit<CheckboxFieldControlProps, \"aria-label\"> & {\n  /** Helper text shown below the control. Replaced by `error` when an error is set. */\n  hint?: React.ReactNode;\n  /** Error text shown below the control. */\n  error?: React.ReactNode;\n  /** Visible field label. */\n  label: string;\n  /** Label and helper text size. */\n  size: FieldSize;\n  /** Optional supporting text announced as the checkbox description. */\n  description?: React.ReactNode;\n};\n\n/** Ready-to-use single checkbox field with label, description, and helper/error text. */\nexport function CheckboxField({\n  label,\n  description,\n  hint,\n  error,\n  size,\n  name,\n  disabled,\n  ...controlProps\n}: CheckboxFieldProps) {\n  return (\n    <Field name={name} disabled={disabled} invalid={error != null || undefined}>\n      <FieldItem disabled={disabled}>\n        <FieldItemControlGroup>\n          <Checkbox disabled={disabled} {...controlProps} />\n        </FieldItemControlGroup>\n        <FieldItemContent size={size} description={description}>\n          {label}\n        </FieldItemContent>\n      </FieldItem>\n      <FieldHelperText size={size} hint={hint} error={error} />\n    </Field>\n  );\n}\n"],"mappings":";;;;;;;;;;AA2BA,SAAgB,cAAc,EAC5B,OACA,aACA,MACA,OACA,MACA,MACA,UACA,GAAG,gBACkB;CACrB,OACE,qBAAC,OAAD;EAAa;EAAgB;EAAU,SAAS,SAAS,QAAQ,KAAA;EAAjE,UAAA,CACE,qBAAC,WAAD;GAAqB;GAArB,UAAA,CACE,oBAAC,uBAAD,EAAA,UACE,oBAAC,UAAD;IAAoB;IAAU,GAAI;GAAe,CAAA,EAC5B,CAAA,GACvB,oBAAC,kBAAD;IAAwB;IAAmB;IACxC,UAAA;GACe,CAAA,CACT;EACX,CAAA,GAAA,oBAAC,iBAAD;GAAuB;GAAY;GAAa;EAAQ,CAAA,CACnD;;AAEX"}