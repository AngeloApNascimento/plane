{"version":3,"file":"accordion.js","names":["Accordion","BaseAccordion","AccordionElement"],"sources":["../../../src/components/accordion/accordion.tsx"],"sourcesContent":["import { Accordion as BaseAccordion } from \"@base-ui/react/accordion\";\nimport type { AccordionRoot } from \"@base-ui/react/accordion\";\n\nimport { Accordion as AccordionElement } from \"../../elements/accordion\";\n\n// Mirror `BaseAccordion.Root`'s own `Value` generic (default `any`), so propel narrows nothing Base\n// UI doesn't; callers can still parameterize it.\nexport type AccordionProps<Value = any> = Omit<AccordionRoot.Props<Value>, \"className\" | \"style\">;\n\n/**\n * Groups a set of `AccordionItem`s. Single-open by default; pass `multiple` to allow several panels\n * open at once. Use `defaultValue` (uncontrolled) or `value` + `onValueChange` (controlled) to\n * drive which items are expanded. Grafts Base UI's accordion behavior onto the styled `Accordion`\n * frame.\n */\nexport function Accordion<Value = any>(props: AccordionProps<Value>) {\n  return <BaseAccordion.Root {...props} render={<AccordionElement />} />;\n}\n"],"mappings":";;;;;;;;;;;AAeA,SAAgBA,YAAuB,OAA8B;CACnE,OAAO,oBAACC,UAAc,MAAf;EAAoB,GAAI;EAAO,QAAQ,oBAACC,aAAD,CAAmB,CAAA;CAAI,CAAA;AACvE"}