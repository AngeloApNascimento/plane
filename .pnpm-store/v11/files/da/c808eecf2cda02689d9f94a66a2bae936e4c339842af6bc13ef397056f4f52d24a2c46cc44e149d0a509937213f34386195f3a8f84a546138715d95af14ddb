{"version":3,"file":"menu-checkbox-item.js","names":["BaseMenu","MenuCheckboxItemElement"],"sources":["../../../src/components/menu/menu-checkbox-item.tsx"],"sourcesContent":["import { Menu as BaseMenu } from \"@base-ui/react/menu\";\nimport { Check } from \"lucide-react\";\nimport type * as React from \"react\";\n\nimport {\n  MenuCheckboxItem as MenuCheckboxItemElement,\n  MenuCheckboxItemIndicator,\n  MenuItemContent,\n  MenuItemControl,\n  MenuItemTrailing,\n  MenuItemTitle,\n  MenuItemTitleRow,\n  type MenuItemVariant,\n} from \"../../elements/menu\";\n\nexport type MenuCheckboxItemProps = Omit<\n  BaseMenu.CheckboxItem.Props,\n  \"children\" | \"className\" | \"label\" | \"style\" | \"render\"\n> & {\n  /**\n   * Row look. `neutral` is the standard text hierarchy, `accent` marks the primary action, and\n   * `danger` marks a destructive one.\n   *\n   * @default \"neutral\"\n   */\n  variant?: MenuItemVariant;\n  /** Leading element shown after the checkbox, e.g. `<Icon icon={Settings} tint=\"secondary\" />`. */\n  icon?: React.ReactNode;\n  /** Primary row label. */\n  label: string;\n  /** Content pinned at the row's inline end, e.g. `<Shortcut keys=\"⌘ K\" />` or a count `<Badge />`. */\n  trailing?: React.ReactElement;\n};\n\n/**\n * The ready-made toggleable multi-select menu row: grafts Base UI's `Menu.CheckboxItem` behavior\n * onto the styled `MenuCheckboxItem` and lays out the checkbox box (a kept-mounted\n * `Menu.CheckboxItemIndicator` grafted onto `MenuCheckboxItemIndicator` + a lucide `Check`),\n * optional leading icon, label, and end content. Base UI's `Menu.CheckboxItem` tracks the checked\n * state, so `checked` / `defaultChecked` / `onCheckedChange` forward straight to it and the\n * indicator reads it from context.\n */\nexport function MenuCheckboxItem({\n  variant,\n  icon,\n  label,\n  trailing,\n  ...props\n}: MenuCheckboxItemProps) {\n  return (\n    <BaseMenu.CheckboxItem {...props} render={<MenuCheckboxItemElement variant={variant} />}>\n      <MenuItemControl>\n        <BaseMenu.CheckboxItemIndicator keepMounted render={<MenuCheckboxItemIndicator />}>\n          <Check aria-hidden />\n        </BaseMenu.CheckboxItemIndicator>\n      </MenuItemControl>\n      {icon}\n      <MenuItemContent>\n        <MenuItemTitleRow>\n          <MenuItemTitle>{label}</MenuItemTitle>\n        </MenuItemTitleRow>\n      </MenuItemContent>\n      {trailing != null ? <MenuItemTrailing>{trailing}</MenuItemTrailing> : null}\n    </BaseMenu.CheckboxItem>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;AA0CA,SAAgB,iBAAiB,EAC/B,SACA,MACA,OACA,UACA,GAAG,SACqB;CACxB,OACE,qBAACA,KAAS,cAAV;EAAuB,GAAI;EAAO,QAAQ,oBAACC,oBAAD,EAAkC,QAAU,CAAA;EAAtF,UAAA;GACE,oBAAC,iBAAD,EAAA,UACE,oBAACD,KAAS,uBAAV;IAAgC,aAAA;IAAY,QAAQ,oBAAC,2BAAD,CAA4B,CAAA;IAC9E,UAAA,oBAAC,OAAD,EAAO,eAAA,KAAa,CAAA;GACU,CAAA,EACjB,CAAA;GAChB;GACD,oBAAC,iBAAD,EAAA,UACE,oBAAC,kBAAD,EAAA,UACE,oBAAC,eAAD,EAAA,UAAgB,MAAqB,CAAA,EACrB,CAAA,EACH,CAAA;GAChB,YAAY,OAAO,oBAAC,kBAAD,EAAA,UAAmB,SAA2B,CAAA,IAAI;EACjD;;AAE3B"}