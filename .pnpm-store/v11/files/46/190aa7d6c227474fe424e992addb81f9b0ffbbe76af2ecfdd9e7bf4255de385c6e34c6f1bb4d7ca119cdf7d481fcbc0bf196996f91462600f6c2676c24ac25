{"version":3,"file":"combobox-select-all.js","names":["ComboboxItemElement"],"sources":["../../../src/components/combobox/combobox-select-all.tsx"],"sourcesContent":["import { Check, Minus } from \"lucide-react\";\n\nimport {\n  ComboboxCheckboxItemIndicator,\n  ComboboxItem as ComboboxItemElement,\n  ComboboxItemContent,\n  ComboboxItemControl,\n  ComboboxItemTitle,\n} from \"../../elements/combobox\";\n\nexport type ComboboxSelectAllProps = {\n  /**\n   * Visible row label.\n   *\n   * @default \"Select all\"\n   */\n  label?: string;\n  /** Whether every item is currently selected. */\n  checked: boolean;\n  /**\n   * Whether only some (not all) items are currently selected — shows a dash instead of a check.\n   * Takes precedence over `checked` for both the glyph and `aria-checked=\"mixed\"`.\n   *\n   * @default false\n   */\n  indeterminate?: boolean;\n  /** Disables the row. */\n  disabled?: boolean;\n  /** Called when the row is activated. */\n  onClick: () => void;\n};\n\n/**\n * Sticky \"select every item\" row for a multi-select combobox panel. Not a `ComboboxItem` — it is\n * not a list option — so compose it in `ComboboxContent`'s `search` slot above the scrolling list.\n */\nexport function ComboboxSelectAll({\n  label = \"Select all\",\n  checked,\n  indeterminate = false,\n  disabled,\n  onClick,\n}: ComboboxSelectAllProps) {\n  return (\n    <ComboboxItemElement\n      render={<button type=\"button\" disabled={disabled} />}\n      role=\"checkbox\"\n      aria-checked={indeterminate ? \"mixed\" : checked}\n      data-selected={checked ? \"\" : undefined}\n      data-indeterminate={indeterminate ? \"\" : undefined}\n      data-disabled={disabled ? \"\" : undefined}\n      // Keep focus where it was. This row sits in the panel HEADER, outside\n      // `store.state.listElement` — and `Combobox.Popup`'s `onFocus` only bounces focus back to the\n      // input for targets inside the list or the popup itself, so without this a click parks focus\n      // on the button and typing / Arrow Up / Arrow Down stop reaching the combobox until the user\n      // clicks the search field again. Base UI's own `Combobox.Clear` does exactly this.\n      onMouseDown={(event) => event.preventDefault()}\n      onClick={onClick}\n    >\n      <ComboboxItemControl>\n        <ComboboxCheckboxItemIndicator\n          data-selected={checked ? \"\" : undefined}\n          data-indeterminate={indeterminate ? \"\" : undefined}\n        >\n          {indeterminate ? <Minus aria-hidden /> : <Check aria-hidden />}\n        </ComboboxCheckboxItemIndicator>\n      </ComboboxItemControl>\n      <ComboboxItemContent>\n        <ComboboxItemTitle>{label}</ComboboxItemTitle>\n      </ComboboxItemContent>\n    </ComboboxItemElement>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;AAoCA,SAAgB,kBAAkB,EAChC,QAAQ,cACR,SACA,gBAAgB,OAChB,UACA,WACyB;CACzB,OACE,qBAACA,cAAD;EACE,QAAQ,oBAAC,UAAD;GAAQ,MAAK;GAAmB;EAAW,CAAA;EACnD,MAAK;EACL,gBAAc,gBAAgB,UAAU;EACxC,iBAAe,UAAU,KAAK,KAAA;EAC9B,sBAAoB,gBAAgB,KAAK,KAAA;EACzC,iBAAe,WAAW,KAAK,KAAA;EAM/B,cAAc,UAAU,MAAM,eAAe;EACpC;EAbX,UAAA,CAeE,oBAAC,qBAAD,EAAA,UACE,oBAAC,+BAAD;GACE,iBAAe,UAAU,KAAK,KAAA;GAC9B,sBAAoB,gBAAgB,KAAK,KAAA;GAExC,UAAA,gBAAgB,oBAAC,OAAD,EAAO,eAAA,KAAa,CAAA,IAAI,oBAAC,OAAD,EAAO,eAAA,KAAa,CAAA;EAChC,CAAA,EACZ,CAAA,GACrB,oBAAC,qBAAD,EAAA,UACE,oBAAC,mBAAD,EAAA,UAAoB,MAAyB,CAAA,EAC1B,CAAA,CACF;;AAEzB"}