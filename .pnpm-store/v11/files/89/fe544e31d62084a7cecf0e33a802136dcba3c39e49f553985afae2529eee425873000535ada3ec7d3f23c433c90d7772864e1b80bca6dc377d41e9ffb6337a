{"version":3,"file":"dialog-close.js","names":["BaseDialog"],"sources":["../../../src/components/dialog/dialog-close.tsx"],"sourcesContent":["import { Dialog as BaseDialog } from \"@base-ui/react/dialog\";\n\nexport type DialogCloseProps = Omit<BaseDialog.Close.Props, \"className\" | \"style\">;\n\n/**\n * The behavior that closes the dialog when activated. Use as the `render` target of a `Button` or\n * `IconButton` so the styled primitive's look wins via render-composition. Corner dismiss belongs\n * in `DialogCloseGroup`:\n *\n * ```tsx\n * <DialogCloseGroup>\n *   <IconButton\n *     variant=\"ghost\"\n *     size=\"xs\"\n *     aria-label={closeLabel}\n *     icon={<Icon icon={X} />}\n *     render={<DialogClose />}\n *   />\n * </DialogCloseGroup>;\n * ```\n *\n * Maps 1:1 to `Dialog.Close`.\n */\nexport function DialogClose(props: DialogCloseProps) {\n  return <BaseDialog.Close {...props} />;\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;AAuBA,SAAgB,YAAY,OAAyB;CACnD,OAAO,oBAACA,OAAW,OAAZ,EAAkB,GAAI,MAAQ,CAAA;AACvC"}