{"version":3,"file":"select-trigger.js","names":["BaseSelect","SelectTriggerElement","IconSlot"],"sources":["../../../src/components/select/select-trigger.tsx"],"sourcesContent":["import { Select as BaseSelect } from \"@base-ui/react/select\";\nimport { ChevronDown } from \"lucide-react\";\nimport type * as React from \"react\";\n\nimport {\n  SelectTrigger as SelectTriggerElement,\n  type SelectTriggerSize,\n  type SelectTriggerVariant,\n  SelectValue,\n} from \"../../elements/select\";\nimport { Icon as IconSlot } from \"../../internal/icon\";\n\nexport type SelectTriggerProps = Omit<\n  BaseSelect.Trigger.Props,\n  \"children\" | \"className\" | \"render\" | \"style\"\n> & {\n  /** Visual size of the trigger: controls its height, text, and icon size. Required. */\n  size: SelectTriggerSize;\n  /**\n   * Figma \"Prominence\": `secondary` is the bordered surface, `ghost` drops the border and fill.\n   *\n   * @default \"secondary\"\n   */\n  variant?: SelectTriggerVariant;\n  /** Shown in the trigger while nothing is selected — Base UI's `Select.Value` placeholder. */\n  placeholder?: React.ReactNode;\n  /** Element shown before the value, e.g. `<Icon icon={Server} tint=\"placeholder\" />`. */\n  icon?: React.ReactNode;\n};\n\n/**\n * The ready-made select trigger: grafts Base UI's `Select.Trigger` behavior onto the styled trigger\n * and bakes its anatomy — an optional leading icon, the selected value (Base UI's `Select.Value`\n * grafted onto `SelectValue`), and the owned chevron indicator. Children are baked, so the prop is\n * omitted.\n */\nexport function SelectTrigger({ size, variant, placeholder, icon, ...props }: SelectTriggerProps) {\n  return (\n    <BaseSelect.Trigger {...props} render={<SelectTriggerElement size={size} variant={variant} />}>\n      {icon}\n      <BaseSelect.Value render={<SelectValue />} placeholder={placeholder} />\n      <IconSlot tint=\"secondary\">\n        <ChevronDown aria-hidden />\n      </IconSlot>\n    </BaseSelect.Trigger>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;AAoCA,SAAgB,cAAc,EAAE,MAAM,SAAS,aAAa,MAAM,GAAG,SAA6B;CAChG,OACE,qBAACA,OAAW,SAAZ;EAAoB,GAAI;EAAO,QAAQ,oBAACC,iBAAD;GAA4B;GAAe;EAAU,CAAA;EAA5F,UAAA;GACG;GACD,oBAACD,OAAW,OAAZ;IAAkB,QAAQ,oBAAC,aAAD,CAAc,CAAA;IAAgB;GAAc,CAAA;GACtE,oBAACE,MAAD;IAAU,MAAK;IACb,UAAA,oBAAC,aAAD,EAAa,eAAA,KAAa,CAAA;GAClB,CAAA;EACQ;;AAExB"}