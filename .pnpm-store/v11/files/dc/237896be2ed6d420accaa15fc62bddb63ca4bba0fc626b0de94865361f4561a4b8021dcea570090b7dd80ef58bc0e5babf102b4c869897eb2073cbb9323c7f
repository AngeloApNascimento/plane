railing}</CollapsibleTriggerTrailing>\n        ) : null}\n      </CollapsibleHeader>\n      <BaseCollapsible.Panel\n        keepMounted={keepMounted}\n        hiddenUntilFound={hiddenUntilFound}\n        render={<CollapsiblePanel />}\n      >\n        <CollapsiblePanelContent placement={placement}>{children}</CollapsiblePanelContent>\n      </BaseCollapsible.Panel>\n    </BaseCollapsible.Root>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;AAmEA,SAAgBA,cAAY,EAC1B,MACA,SACA,UACA,UACA,YAAY,MACZ,YAAY,UACZ,aACA,kBACA,QACA,GAAG,SACgB;CACnB,OAGE,qBAACC,YAAgB,MAAjB;EAAsB,GAAI;EAAO,QAAQ,oBAACC,eAAD,EAA4B,OAAS,CAAA;EAA9E,UAAA,CACE,qBAAC,mBAAD;GAA8B;GAA9B,UAAA,CACE,qBAACD,YAAgB,SAAjB;IAAyB,QAAQ,oBAAC,oBAAD,EAA+B,UAAY,CAAA;IAA5E,UAAA;KACG,cAAc,WAAW,OAAO;KACjC,qBAAC,yBAAD;MAAoC;MAApC,UAAA,CACG,cAAc,YAAY,OAAO,MACjC,OACsB;;KACxB,YACC,oBAAC,qBAAD;MAAqB,QAAO;MAAW,MAAK;MAC1C,UAAA,oBAAC,aAAD,CAAc,CAAA;KACK,CAAA,IACnB;IACmB;GACxB,CAAA,GAAA,WACC,oBAAC,4BAAD;IAAuC;IAAY,UAAA;GAAqC,CAAA,IACtF,IACa;EACnB,CAAA,GAAA,oBAACA,YAAgB,OAAjB;GACe;GACK;GAClB,QAAQ,oBAAC,kBAAD,CAAmB,CAAA;GAE3B,UAAA,oBAAC,yBAAD;IAAoC;IAAY;GAAkC,CAAA;EAC7D,CAAA,CACH;;AAE1B"}