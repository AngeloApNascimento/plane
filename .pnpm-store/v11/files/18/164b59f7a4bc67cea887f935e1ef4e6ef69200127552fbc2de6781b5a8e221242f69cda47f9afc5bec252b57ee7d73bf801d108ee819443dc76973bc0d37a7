ng\" ? tooltip || undefined : undefined;\n  const accessibleName = alt ?? tooltipLabel;\n  const a11y =\n    accessibleName != null\n      ? { role: \"img\", \"aria-label\": accessibleName }\n      : { \"aria-hidden\": true };\n  const avatar = (\n    // Base UI's `Avatar` behavior grafts onto the styled `elements` parts via `render` (behavior part\n    // outer, styled part as the render target). `{...props}` spreads before the hardcoded a11y attrs\n    // so a stray same-named prop can never silently override them.\n    // Presentation alone does not add a tab stop. Interactive callers own a button/link wrapper.\n    <BaseAvatar.Root\n      {...props}\n      render={<WorkspaceAvatarElement size={size} />}\n      {...a11y}\n      tabIndex={tabIndex}\n    >\n      {src ? <BaseAvatar.Image render={<WorkspaceAvatarImage />} src={src} alt=\"\" /> : null}\n      {hasInitials ? (\n        <BaseAvatar.Fallback\n          delay={delay}\n          render={<WorkspaceAvatarFallback variant={resolvedVariant} />}\n        >\n          {displayFallback}\n        </BaseAvatar.Fallback>\n      ) : (\n        <BaseAvatar.Fallback delay={delay} render={<Icon tint=\"muted\" />}>\n          <Building2 />\n        </BaseAvatar.Fallback>\n      )}\n    </BaseAvatar.Root>\n  );\n  return tooltipLabel ? <Tooltip label={tooltipLabel}>{avatar}</Tooltip> : avatar;\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;AAyCA,SAAgB,gBAAgB,EAC9B,MACA,KACA,KACA,UACA,OACA,SACA,UACA,GAAG,SACoB;CAQvB,MAAM,kBAAkB,MAAM,cAAc,kBAAkB,GAAG,GAAG,CAAC,GAAG,CAAC;CACzE,MAAM,mBAAmB,YAAY;CACrC,MAAM,kBACJ,SAAS,SAAS,OAAO,qBAAqB,WAC1C,sBAAsB,gBAAgB,IACtC;CACN,MAAM,cAAc,oBAAoB;CAGxC,MAAM,kBAAkB,iBAAiB,qBAAqB,KAAK,gBAAgB,CAAC;CAOpF,MAAM,eACJ,YAAY,OAAO,MAAM,OAAO,YAAY,WAAW,WAAW,KAAA,IAAY,KAAA;CAChF,MAAM,iBAAiB,OAAO;CAC9B,MAAM,OACJ,kBAAkB,OACd;EAAE,MAAM;EAAO,cAAc;CAAe,IAC5C,EAAE,eAAe,KAAK;CAC5B,MAAM,SAKJ,qBAACA,OAAW,MAAZ;EACE,GAAI;EACJ,QAAQ,oBAACC,mBAAD,EAA8B,KAAO,CAAA;EAC7C,GAAI;EACM;EAJZ,UAAA,CAMG,MAAM,oBAACD,OAAW,OAAZ;GAAkB,QAAQ,o