{"version":3,"file":"combobox-chips.js","names":["BaseCombobox","ComboboxChipsElement","ComboboxChipOverflowElement","ComboboxInputElement"],"sources":["../../../src/components/combobox/combobox-chips.tsx"],"sourcesContent":["import { Combobox as BaseCombobox } from \"@base-ui/react/combobox\";\nimport { ChevronDown } from \"lucide-react\";\nimport type * as React from \"react\";\n\nimport {\n  type ComboboxChipSize,\n  type ComboboxSize,\n  type ComboboxVariant,\n  ComboboxChipOverflow as ComboboxChipOverflowElement,\n  ComboboxChips as ComboboxChipsElement,\n  ComboboxInput as ComboboxInputElement,\n} from \"../../elements/combobox\";\nimport { Icon } from \"../../internal/icon\";\nimport { ComboboxChipSizeContext } from \"./combobox-chip-size-context\";\n\n// The chip rung inside each frame rung: a 28/32/36/40px frame seats a 20/24/28/32px chip — always\n// exactly one ladder rung down. The overflow \"+N more\" count is chip-scale text, so it takes the\n// same mapped value.\nconst CHIP_SIZE: Record<ComboboxSize, ComboboxChipSize> = {\n  md: \"xs\",\n  lg: \"sm\",\n  xl: \"md\",\n  \"2xl\": \"lg\",\n};\n\nexport type ComboboxChipsProps<Value = string> = {\n  /**\n   * Frame look. `neutral` is the bordered field surface; `ghost` is borderless.\n   *\n   * @default \"neutral\"\n   */\n  variant?: ComboboxVariant;\n  /** Visual size of the chips frame: height, text, and glyph sizing. Required. */\n  size: ComboboxSize;\n  /** Input placeholder shown while typing to add another value. */\n  placeholder?: string;\n  /**\n   * Cap on how many chips render inline. When more are selected, the frame collapses to a single\n   * row showing the first `maxVisible` chips followed by an overflow count (the rest stay managed\n   * from the popup). Omit for the default behavior — chips wrap onto new rows as the selection\n   * grows.\n   */\n  maxVisible?: number;\n  /**\n   * Copy for the overflow count when `maxVisible` hides selected chips. Called with how many values\n   * are hidden. Override to localize.\n   *\n   * @default (hiddenCount) => `+${hiddenCount} more`\n   */\n  overflowLabel?: (hiddenCount: number) => React.ReactNode;\n  /**\n   * The popup-trigger control (e.g. an `IconButton`), grafted onto Base UI's `Trigger` behavior. It\n   * carries its own — localizable — `aria-label`. Omit it to show a decorative chevron (the Figma\n   * end node) — the input still opens the list.\n   */\n  trigger?: React.ReactElement;\n  /**\n   * Renders one selected value as a `ComboboxChip` — the `ComboboxChips` counterpart of\n   * `ComboboxList`'s item template. Set your own `key`, exactly like `ComboboxList`'s function\n   * child, e.g. `(value) => <ComboboxChip key={value} label={value} remove={<... />} />`.\n   */\n  children: (value: Value) => React.ReactNode;\n};\n\n/**\n * The ready-made multiselect input frame — it replaces `ComboboxInputGroup` in the `multiple`\n * anatomy. Grafts Base UI's `Chips` behavior onto the styled `elements/combobox` frame, owning only\n * the frame, the selected-values loop, and `maxVisible` overflow ahead of the inline input — each\n * chip's template is the consumer's `children`, mirroring `ComboboxList`. Without `maxVisible` the\n * chips wrap onto new rows; with it the frame collapses to one row of the first `maxVisible` chips\n * plus an overflow count (`+N more` by default; pass `overflowLabel` to localize). Arrow keys move\n * focus across chips; Backspace removes.\n */\nexport function ComboboxChips<Value = string>({\n  size,\n  variant,\n  placeholder,\n  maxVisible,\n  overflowLabel = (hiddenCount) => `+${hiddenCount} more`,\n  trigger,\n  children,\n}: ComboboxChipsProps<Value>) {\n  const layout = maxVisible != null ? \"collapse\" : \"wrap\";\n  return (\n    // Chips are rendered by the caller's `children`, so the frame publishes the CHIP rung\n    // (one ladder step below its own) through context — see `combobox-chip-size-context`.\n    <ComboboxChipSizeContext.Provider value={CHIP_SIZE[size]}>\n      <BaseCombobox.Chips\n        render={<ComboboxChipsElement size={size} variant={variant} layout={layout} />}\n      >\n        <BaseCombobox.Value>\n          {(values: Value[]) => {\n            const visible = maxVisible != null ? values.slice(0, maxVisible) : values;\n            const hiddenCount = values.length - visible.length;\n            return (\n              <>\n                {visible.map(children)}\n                {hiddenCount > 0 ? (\n                  <ComboboxChipOverflowElement size={CHIP_SIZE[size]}>\n                    {overflowLabel(hiddenCount)}\n                  </ComboboxChipOverflowElement>\n                ) : null}\n                <BaseCombobox.Input render={<ComboboxInputElement />} placeholder={placeholder} />\n              </>\n            );\n          }}\n        </BaseCombobox.Value>\n        {trigger != null ? (\n          <BaseCombobox.Trigger render={trigger} />\n        ) : (\n          <Icon tint=\"secondary\">\n            <ChevronDown aria-hidden />\n          </Icon>\n        )}\n      </BaseCombobox.Chips>\n    </ComboboxChipSizeContext.Provider>\n  );\n}\n"],"mappings":";;;;;;;;;;AAkBA,MAAM,YAAoD;CACxD,IAAI;CACJ,IAAI;CACJ,IAAI;CACJ,OAAO;AACT;;;;;;;;;;AAkDA,SAAgB,cAA8B,EAC5C,MACA,SACA,aACA,YACA,iBAAiB,gBAAgB,IAAI,YAAY,QACjD,SACA,YAC4B;CAC5B,MAAM,SAAS,cAAc,OAAO,aAAa;CACjD,OAGE,oBAAC,wBAAwB,UAAzB;EAAkC,OAAO,UAAU;EACjD,UAAA,qBAACA,SAAa,OAAd;GACE,QAAQ,oBAACC,iBAAD;IAA4B;IAAe;IAAiB;GAAS,CAAA;GAD/E,UAAA,CAGE,oBAACD,SAAa,OAAd,EAAA,WACI,WAAoB;IACpB,MAAM,UAAU,cAAc,OAAO,OAAO,MAAM,GAAG,UAAU,IAAI;IACnE,MAAM,cAAc,OAAO,SAAS,QAAQ;IAC5C,OACE,qBAAA,UAAA,EAAA,UAAA;KACG,QAAQ,IAAI,QAAQ;KACpB,cAAc,IACb,oBAACE,sBAAD;MAA6B,MAAM,UAAU;MAC1C,UAAA,cAAc,WAAW;KACC,CAAA,IAC3B;KACJ,oBAACF,SAAa,OAAd;MAAoB,QAAQ,oBAACG,eAAD,CAAuB,CAAA;MAAgB;KAAc,CAAA;IACjF,EAAA,CAAA;GAEN,EACkB,CAAA,GACnB,WAAW,OACV,oBAACH,SAAa,SAAd,EAAsB,QAAQ,QAAU,CAAA,IAExC,oBAAC,MAAD;IAAM,MAAK;IACT,UAAA,oBAAC,aAAD,EAAa,eAAA,KAAa,CAAA;GACtB,CAAA,CAEU;;CACY,CAAA;AAEtC"}