ypeof ref === \"function\") ref(node);\n        else if (ref) ref.current = node;\n      }}\n    />\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;AA6CA,SAAgB,eAAkC,EAChD,cAAc,MACd,KACA,GAAG,SAC+D;CAClE,OACE,oBAACA,QAAY,SAAb;EACE,GAAI;EACJ,MAAM,SAAmC;GACvC,sBAAsB,MAAM,WAAW;GACvC,IAAI,OAAO,QAAQ,YAAY,IAAI,IAAI;QAClC,IAAI,KAAK,IAAI,UAAU;EAC9B;CACD,CAAA;AAEL"}