{"version":3,"file":"scroll-area.js","names":["ScrollArea","BaseScrollArea","ScrollAreaElement"],"sources":["../../../src/components/scroll-area/scroll-area.tsx"],"sourcesContent":["import { ScrollArea as BaseScrollArea } from \"@base-ui/react/scroll-area\";\nimport * as React from \"react\";\n\nimport {\n  ScrollArea as ScrollAreaElement,\n  ScrollAreaCorner,\n  ScrollAreaScrollbar,\n  type ScrollAreaScrollbarSize,\n  type ScrollAreaScrollbarVisibility,\n  ScrollAreaThumb,\n  ScrollAreaViewport,\n} from \"../../elements/scroll-area\";\n\nexport type {\n  ScrollAreaScrollbarSize,\n  ScrollAreaScrollbarVisibility,\n} from \"../../elements/scroll-area\";\n\n// propel's scroll container, built on Base UI ScrollArea. Unlike a re-skinned native\n// scrollbar it paints a real DOM thumb, so it renders consistently across browsers\n// (including Firefox and touch), insets the thumb from the edge, and reveals only on\n// interaction. The thumb uses propel's `--scrollbar-thumb*` tokens: shown while the\n// area is hovered or scrolling, darker on thumb hover, darkest while dragging, over a\n// transparent track (specs + in-product example). It fills its parent, so constrain the\n// parent's height (or width) to make the content scroll. Reveal/width are driven by the\n// `visibility` and `size` props threaded to each `ScrollAreaScrollbar`. Base UI Root props\n// (minus className/style/render) forward onto the root for ids, aria, overflow thresholds, etc.\n//\n// Base UI's optional `ScrollArea.Content` wrapper is intentionally omitted: Figma has no\n// Content part, Content is unstyled in typical use, and children sit directly in the Viewport\n// (composers who need Content can graft Base UI themselves).\n\n/** Which axes scroll. Drives which scrollbars (and the corner) are rendered. */\nexport type ScrollAreaOrientation = \"vertical\" | \"horizontal\" | \"both\";\n\nexport type ScrollAreaProps = Omit<\n  BaseScrollArea.Root.Props,\n  \"className\" | \"style\" | \"render\" | \"children\"\n> & {\n  /**\n   * Which axes scroll (required, no silent default). `vertical`/`horizontal` render a single\n   * scrollbar; `both` renders both plus the corner. Render only the axes the content can actually\n   * overflow so an unused scrollbar never reserves space or reveals.\n   */\n  orientation: ScrollAreaOrientation;\n  /**\n   * When the scrollbar is shown. `auto` hides it at rest and reveals it on hover/scroll (fades when\n   * idle). `always` keeps it permanently visible.\n   *\n   * @default \"auto\"\n   */\n  visibility?: ScrollAreaScrollbarVisibility;\n  /**\n   * Scrollbar gutter size (Figma Scrollbar set). Stable full gutter; pad matches native\n   * `scrollbar-*`: `sm` — 12 px / 4 → 4 px thumb; `md` — 14 / 4 → 6; `lg` — 16 / 4 → 8.\n   *\n   * @default \"sm\"\n   */\n  size?: ScrollAreaScrollbarSize;\n  /** The scrollable content (rendered inside the viewport). */\n  children: React.ReactNode;\n};\n\n/**\n * A scroll container with propel's overlay scrollbar, built on Base UI `ScrollArea`. Use it to wrap\n * any overflowing content (menus, panels, long lists). Place it as a child of a height-constrained\n * flex column: it grows to fill the column and its viewport scrolls when the content overflows.\n */\nexport function ScrollArea({\n  orientation,\n  visibility = \"auto\",\n  size = \"sm\",\n  children,\n  ...props\n}: ScrollAreaProps) {\n  const showVertical = orientation !== \"horizontal\";\n  const showHorizontal = orientation !== \"vertical\";\n  return (\n    // Sizing is a flex chain, not a percentage-height chain (which does not resolve\n    // through flex). The Root is a flex item that also lays its viewport out as a flex\n    // column; the Viewport is a `flex-1` child whose `overflow: scroll` (set by Base UI)\n    // gives it an automatic min-height of 0, so it bounds to the column and scrolls. The\n    // scrollbars are positioned absolutely by Base UI, so they never take flex space. The\n    // Base UI behavior parts graft onto the styled `elements` parts via `render`.\n    <BaseScrollArea.Root {...props} render={<ScrollAreaElement />}>\n      <BaseScrollArea.Viewport render={<ScrollAreaViewport />}>{children}</BaseScrollArea.Viewport>\n      {showVertical ? (\n        <BaseScrollArea.Scrollbar\n          orientation=\"vertical\"\n          render={<ScrollAreaScrollbar visibility={visibility} size={size} />}\n        >\n          <BaseScrollArea.Thumb render={<ScrollAreaThumb />} />\n        </BaseScrollArea.Scrollbar>\n      ) : null}\n      {showHorizontal ? (\n        <BaseScrollArea.Scrollbar\n          orientation=\"horizontal\"\n          render={<ScrollAreaScrollbar visibility={visibility} size={size} />}\n        >\n          <BaseScrollArea.Thumb render={<ScrollAreaThumb />} />\n        </BaseScrollArea.Scrollbar>\n      ) : null}\n      {orientation === \"both\" ? <BaseScrollArea.Corner render={<ScrollAreaCorner />} /> : null}\n    </BaseScrollArea.Root>\n  );\n}\n"],"mappings":";;;;;;;;;;;;;;;AAoEA,SAAgBA,aAAW,EACzB,aACA,aAAa,QACb,OAAO,MACP,UACA,GAAG,SACe;CAClB,MAAM,eAAe,gBAAgB;CACrC,MAAM,iBAAiB,gBAAgB;CACvC,OAOE,qBAACC,WAAe,MAAhB;EAAqB,GAAI;EAAO,QAAQ,oBAACC,cAAD,CAAoB,CAAA;EAA5D,UAAA;GACE,oBAACD,WAAe,UAAhB;IAAyB,QAAQ,oBAAC,oBAAD,CAAqB,CAAA;IAAI;GAAkC,CAAA;GAC3F,eACC,oBAACA,WAAe,WAAhB;IACE,aAAY;IACZ,QAAQ,oBAAC,qBAAD;KAAiC;KAAkB;IAAO,CAAA;IAElE,UAAA,oBAACA,WAAe,OAAhB,EAAsB,QAAQ,oBAAC,iBAAD,CAAkB,CAAA,EAAI,CAAA;GAC5B,CAAA,IACxB;GACH,iBACC,oBAACA,WAAe,WAAhB;IACE,aAAY;IACZ,QAAQ,oBAAC,qBAAD;KAAiC;KAAkB;IAAO,CAAA;IAElE,UAAA,oBAACA,WAAe,OAAhB,EAAsB,QAAQ,oBAAC,iBAAD,CAAkB,CAAA,EAAI,CAAA;GAC5B,CAAA,IACxB;GACH,gBAAgB,SAAS,oBAACA,WAAe,QAAhB,EAAuB,QAAQ,oBAAC,kBAAD,CAAmB,CAAA,EAAI,CAAA,IAAI;EACjE;;AAEzB"}