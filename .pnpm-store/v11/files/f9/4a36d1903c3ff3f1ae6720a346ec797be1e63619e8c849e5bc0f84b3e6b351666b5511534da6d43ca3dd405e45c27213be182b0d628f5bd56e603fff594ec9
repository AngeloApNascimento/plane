{"version":3,"file":"tooltip-popup.js","names":[],"sources":["../../../src/elements/tooltip/tooltip-popup.tsx"],"sourcesContent":["import { mergeProps } from \"@base-ui/react/merge-props\";\nimport { useRender } from \"@base-ui/react/use-render\";\n\nimport {\n  tooltipPopupVariants,\n  type TooltipLayout,\n  type TooltipPopupVariantProps,\n} from \"./variants\";\n\nexport type { TooltipLayout } from \"./variants\";\n\nexport type TooltipPopupProps = Omit<useRender.ComponentProps<\"div\">, \"className\" | \"style\"> &\n  Omit<TooltipPopupVariantProps, \"layout\"> & {\n    /**\n     * Content arrangement. `single` is the one-line Figma singleline chip (`whitespace-nowrap` —\n     * long labels do not wrap); `stacked` is the multiline description layout (body type, larger\n     * radius, soft max width, shortcut below).\n     *\n     * @default \"single\"\n     */\n    layout?: TooltipLayout;\n  };\n\n/**\n * The styled tooltip surface — adaptive popup with caption/body text, radius, shadow, and the gap\n * to the shortcut. `layout` switches Figma singleline vs multiline chrome. Base-UI-agnostic; graft\n * in `components` via `<BaseTooltip.Popup render={<TooltipPopup/>} />`.\n */\nexport function TooltipPopup({ layout = \"single\", render, ...props }: TooltipPopupProps) {\n  const defaultProps: useRender.ElementProps<\"div\"> = {\n    className: tooltipPopupVariants({ layout }),\n  };\n  return useRender({ defaultTagName: \"div\", render, props: mergeProps(defaultProps, props) });\n}\n"],"mappings":";;;;;;;;;;AA4BA,SAAgB,aAAa,EAAE,SAAS,UAAU,QAAQ,GAAG,SAA4B;CAIvF,OAAO,UAAU;EAAE,gBAAgB;EAAO;EAAQ,OAAO,WAAW,EAFlE,WAAW,qBAAqB,EAAE,OAAO,CAAC,EAEmC,GAAG,KAAK;CAAE,CAAC;AAC5F"}