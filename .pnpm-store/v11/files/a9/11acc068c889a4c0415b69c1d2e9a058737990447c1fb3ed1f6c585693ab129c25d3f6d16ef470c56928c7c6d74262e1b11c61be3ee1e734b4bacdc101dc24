{"version":3,"file":"item-indicator.js","names":[],"sources":["../../src/internal/item-indicator.ts"],"sourcesContent":["import { cx } from \"class-variance-authority\";\n\nimport { nodeSlotClass } from \"./node-slot\";\n\n/**\n * The shared selected-check slot chrome (rule 4a): an accent-tinted node slot that hides its glyph\n * while the row is unselected (`data-selected` comes from the Base UI `ItemIndicator` graft, which\n * passes `keepMounted` so the gutter column holds). Side-agnostic on its own; every family composes\n * it at the row's inline-END, the single-select half of the Figma split that keeps the multi-select\n * checkbox leading. Composed by the select/combobox/menu/context-menu item indicators — before this\n * each re-spelled it, and combobox had drifted to an untinted check.\n */\nconst itemIndicatorBaseClass = cx(nodeSlotClass, \"text-icon-accent-primary [--node-size:1rem]\");\n\nexport const itemIndicatorClass = cx(itemIndicatorBaseClass, \"not-data-selected:invisible\");\n\n/**\n * The same slot keyed off `data-unchecked` instead of `data-selected` — for a Base UI\n * `RadioItemIndicator`, which stamps `data-checked` / `data-unchecked` on itself rather than the\n * `data-selected` an `ItemIndicator` graft carries. Same chrome, different state attribute; the\n * geometry stays in `itemIndicatorBaseClass` so the two never drift.\n */\nexport const itemIndicatorUncheckedClass = cx(itemIndicatorBaseClass, \"data-unchecked:invisible\");\n"],"mappings":";;;;;;;;;;;;AAYA,MAAM,yBAAyB,GAAG,eAAe,6CAA6C;AAE9F,MAAa,qBAAqB,GAAG,wBAAwB,6BAA6B;;;;;;;AAQ1F,MAAa,8BAA8B,GAAG,wBAAwB,0BAA0B"}