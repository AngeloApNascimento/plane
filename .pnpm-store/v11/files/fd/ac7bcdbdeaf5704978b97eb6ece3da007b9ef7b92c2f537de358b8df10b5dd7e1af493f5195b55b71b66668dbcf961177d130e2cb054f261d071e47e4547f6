{"version":3,"file":"select-field.js","names":["Select","BaseSelect"],"sources":["../../../src/components/select-field/select-field.tsx"],"sourcesContent":["import { Select as BaseSelect } from \"@base-ui/react/select\";\nimport type * as React from \"react\";\n\nimport { FieldControlContent } from \"../../elements/field/field-control-content\";\nimport { FieldLabelGroup } from \"../../elements/field/field-label-group\";\nimport type { SelectTriggerSize, SelectTriggerVariant } from \"../../elements/select/index\";\nimport { Field, FieldDescription, FieldLabel } from \"../field\";\nimport { FieldHelperText } from \"../field/field-helper-text\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectList,\n  SelectTrigger,\n  type SelectProps,\n} from \"../select\";\n\nexport type { SelectTriggerSize } from \"../../elements/select/index\";\n\nexport type SelectFieldOption = {\n  label: string;\n  value: string;\n};\n\nexport type SelectFieldProps = Omit<SelectProps<string>, \"children\" | \"items\"> & {\n  /**\n   * Supporting text shown below the label, above the trigger. Always shown, alongside\n   * `hint`/`error`.\n   */\n  description?: React.ReactNode;\n  /** Error text shown below the control. */\n  error?: React.ReactNode;\n  /** Helper text shown below the control. Replaced by `error` when an error is set. */\n  hint?: React.ReactNode;\n  /** Element shown before the value, e.g. `<Icon icon={Server} tint=\"placeholder\" />`. */\n  icon?: React.ReactNode;\n  /** Visible field label. */\n  label: string;\n  /** Marks the field required: adds a `*` asterisk and sets `required`. */\n  required?: boolean;\n  /** Trigger, label and helper text size. */\n  size: SelectTriggerSize;\n  /**\n   * Figma \"Prominence\": `secondary` is the bordered trigger, `ghost` drops its border and fill.\n   *\n   * @default \"secondary\"\n   */\n  variant?: SelectTriggerVariant;\n  /** Options rendered in the popup. */\n  options: readonly SelectFieldOption[];\n};\n\n/** Ready-to-use select field with label, trigger, popup options, and helper/error text. */\nexport function SelectField({\n  description,\n  disabled,\n  error,\n  hint,\n  icon,\n  label,\n  required,\n  size,\n  variant,\n  name,\n  options,\n  ...selectProps\n}: SelectFieldProps) {\n  return (\n    <Field name={name} size={size} disabled={disabled} invalid={error != null || undefined}>\n      <Select disabled={disabled} items={options} required={required} {...selectProps}>\n        {/* Graft Base UI's select-label association onto the shared, size-scaled `FieldLabel`\n            (md=body-xs) so the label matches the other field wrappers (input/combobox/autocomplete)\n            — the picker's own fixed-14px `SelectLabel` rendered it a step too large. Elements\n            `FieldLabelGroup` (not the ready-made helper) keeps that graft and the tighter\n            title→description gap. */}\n        <FieldLabelGroup orientation=\"vertical\">\n          <BaseSelect.Label render={<FieldLabel size={size} inset={false} required={required} />}>\n            {label}\n          </BaseSelect.Label>\n          {description != null ? (\n            <FieldDescription size={size}>{description}</FieldDescription>\n          ) : null}\n        </FieldLabelGroup>\n        <FieldControlContent orientation=\"vertical\" size={size}>\n          <SelectTrigger size={size} variant={variant} icon={icon} />\n          <SelectContent alignItemWithTrigger={false}>\n            <SelectList>\n              {/* Figma's popup rows stay a fixed size across every trigger size — only the\n                  trigger/label/helper text scale with `size`. */}\n              {options.map((option) => (\n                <SelectItem\n                  key={option.value}\n                  value={option.value}\n                  size=\"lg\"\n                  label={option.label}\n                />\n              ))}\n            </SelectList>\n          </SelectContent>\n          <FieldHelperText size={size}