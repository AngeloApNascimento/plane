{"version":3,"file":"overlay-panel.js","names":[],"sources":["../../src/internal/overlay-panel.tsx"],"sourcesContent":["import { mergeProps } from \"@base-ui/react/merge-props\";\nimport { useRender } from \"@base-ui/react/use-render\";\nimport { cva, cx, type VariantProps } from \"class-variance-authority\";\nimport * as React from \"react\";\n\nimport { ScrollArea } from \"../components/scroll-area/index\";\nimport { surfaceVariants, type SurfaceVariantProps } from \"./surface\";\n\n// The shared scrollable-overlay shell. Menu surfaces, the context-menu panel, the\n// breadcrumb overflow menu and the toolbar picker all render\n// the same thing: an elevated surface capped at the positioner's available height,\n// whose body scrolls inside a `ScrollArea` while optional sticky chrome (a search\n// header, a footer) stays pinned outside the scroll. This bundles that composition\n// so each call site only supplies its positioner + a Base UI popup, and never\n// re-derives the surface / max-height / overflow / scroll classes (they had drifted\n// across call sites). It pairs with `internal/surface` (the card tokens) the same way.\n//\n// This is a component, but an internal one: it lives outside `components/` and\n// `hooks/` (the only folders the build turns into published subpaths), so it is not\n// part of the package's public API.\n//\n// Two ways families use it:\n// - Wrapper (Menu, ContextMenu): the Base UI popup is `children`, so\n//   menuitems stay direct children of `role=\"menu\"` and header/footer sit outside\n//   that popup (ARIA-valid).\n// - Graft target (Combobox): `Combobox.Popup` renders *this* element, so Search\n//   lives inside `role=\"dialog\"`. Clicking a row then does not leave the popup.\n// The width rule (`internal/popup-width.ts`, tokens in `styles/variables.css`): the panel is as\n// wide as its content, never narrower than the floor and never wider than the ceiling — and both\n// yield to the room Base UI measured beside the anchor (`--available-width`). The floor must yield\n// too: CSS resolves `min-width` over `max-width`, so a floor that did not would push a panel off a\n// narrow screen. `100vw` stands in for the room on a panel rendered outside a positioner.\n//\n// `--popup-held-width` is the width the panel has already reached while open (see\n// `useHeldWidth`). It raises the floor to that width so a list that filters down to its shortest\n// rows keeps the width it opened at, instead of reflowing under the pointer with every keystroke.\nconst popupWidthRule = cx(\n  \"min-w-[min(max(var(--popup-width-min),var(--popup-held-width,0px)),var(--available-width,100vw))]\",\n  \"max-w-[min(var(--popup-width-max),var(--available-width,100vw))]\",\n);\n\n/**\n * Hold an open panel's width: a panel that sizes to its content may grow while it is open (rows\n * arriving, a description appearing) but never shrinks until it closes. A searchable list would\n * otherwise reflow under the pointer as typing filters it down to its shortest rows — the one\n * reason the product code these panels replace pinned a fixed width on every picker. Filterable\n * lists in Base UI, Primer and Ant Design freeze their width the same way (to the anchor or a\n * preset); here the frozen width is the content's own.\n *\n * The widest width seen goes onto the element as `--popup-held-width`, which the width rule reads\n * as part of the floor, so it still yields to the ceiling and to `--available-width`. Keyed by\n * element: the popup mounts fresh each open, so the hold resets with it.\n */\n/**\n * The sizings that hold their width. The deprecated aliases render as `auto`, so they must BEHAVE\n * as `auto` too — gating on the literal `\"auto\"` gave them the styling without the hold, and a\n * filtering list under `sizing=\"menu\"` shrank from 263px to the 192px floor while `sizing=\"auto\"`\n * held at 263px.\n *\n * An omitted `sizing` is deliberately excluded: it means content width with no floor, no ceiling\n * and no hold, so it must keep reflowing.\n */\nexport const holdsWidth = (sizing: OverlayPanelSizing | undefined) =>\n  sizing != null && sizing !== \"anchor\";\n\nfunction useHeldWidth(enabled: boolean): React.RefCallback<HTMLDivElement> | undefined {\n  const [element, setElement] = React.useState<HTMLDivElement | null>(null);\n  React.useLayoutEffect(() => {\n    if (!enabled || element == null) return undefined;\n    let held = 0;\n    const hold = () => {\n      // Layout width: the open transition scales the panel with `transform`, which `offsetWidth`\n      // does not include.\n      const width = element.offsetWidth;\n      if (width > held) {\n        held = width;\n        element.style.setProperty(\"--popup-held-width\", `${width}px`);\n      }\n    };\n    hold();\n    const observer = new ResizeObserver(hold);\n    observer.observe(element);\n    return () => {\n      observer.disconnect();\n      element.style.removeProperty(\"--popup-held-width\");\n    };\n  }, [enabled, element]);\n  return enabled ? setElement : undefined;\n}\n\nconst overlayPanelVariants = cva(\n  cx(\n    // Cap at the height the positioner measured, and lay the sticky header / scroll\n    // body / sticky footer out as a clipped column.\n    \"flex max-h-(--available-height) flex-col overflow-hidden outline-none\",\n    // Open/close animation. `--transform-origin` is set on the Base UI positioner and\n    // inherits down to here. Wrapper families (Menu, ContextMenu) never get\n    // `data-starting-style` on this card — Base UI only sets it on the popup it\n    // renders — so entry uses native `@starting-style` (`starting:`) and exit keys\n    // off that nested popup via `has-[]`. Scope the `has-[]` to `role=menu` /\n    // `role=dialog`: Combobox item indicators also get `data-ending-style` while a\n    // row unchecks, and a bare `:has([data-ending-style])` would fade the whole card\n    // as if it were closing. When this card *is* the popup (Combobox), those\n    // attributes land here; `data-starting-style` / `data-ending-style` cover that\n    // path without breaking the wrapper path.\n    \"origin-(--transform-origin) transition-[transform,opacity] duration-150 ease-out\",\n    \"starting:scale-95 starting:opacity-0\",\n    \"data-starting-style:scale-95 data-starting-style:opacity-0\",\n    \"data-ending-style:scale-95 data-ending-style:opacity-0\",\n    \"has-[[role=menu][data-ending-style]]:scale-95 has-[[role=menu][data-ending-style]]:opacity-0\",\n    \"has-[[role=dialog][data-ending-style]]:scale-95 has-[[role=dialog][data-ending-style]]:opacity-0\",\n  ),\n  {\n    variants: {\n      // Two ways to take a width, nothing in between. `auto` is the content's width between the\n      // floor and the ceiling (`internal/popup-width.ts`), held while open; `anchor` is the\n      // trigger's width — never narrower than it, wider only with its content, capped by the room\n      // beside the anchor rather than the ceiling, because a listbox must cover the field it\n      // belongs to however wide that field is. Height caps stay per mode: `auto` scrolls past\n      // 384px (a long menu), `anchor` past 288px (the combobox listbox, which capped there before\n      // it moved onto this shell — without a cap the base `max-h-(--available-height)` lets a long\n      // option list grow to the whole viewport).\n      sizing: {\n        auto: cx(popupWidthRule, \"max-h-[min(var(--available-height),24rem)]\"),\n        anchor: cx(\n          \"max-h-[min(var(--available-height),18rem)] min-w-(--anchor-width)\",\n          \"max-w-[max(var(--anchor-width),var(--available-width,100vw))]\",\n        ),\n        // The pre-0.4.0 names, kept so a consumer mid-migration compiles and renders unchanged. They\n        // all map to `auto`, which is what replaced them: this cva now offers \"two ways to take a\n        // width, nothing in between\", so the old t-shirt sizes have no separate rule to map back to.\n        // If any of `sm`/`md`/`lg` was meant to keep a distinct width cap, correct the mapping here —\n        // it was inferred from the rewrite, not from their original definitions.\n        /** @deprecated Use `auto`. */\n        menu: cx(popupWidthRule, \"max-h-[min(var(--available-height),24rem)]\"),\n        /** @deprecated Use `auto`. */\n        sm: cx(popupWidthRule, \"max-h-[min(var(--available-height),24rem)]\"),\n        /** @deprecated Use `auto`. */\n        md: cx(popupWidthRule, \"max-h-[min(var(--available-height),24rem)]\"),\n        /** @deprecated Use `auto`. */\n        lg: cx(popupWidthRule, \"max-h-[min(var(--available-height),24rem)]\"),\n      },\n    },\n  },\n);\n\nexport type OverlayPanelSizing = NonNullable<VariantProps<typeof overlayPanelVariants>[\"sizing\"]>;\n\n/** The modes a new call site should use. The pre-0.4.0 names still compile but are deprecated. */\nexport type OverlayPanelSizingCurrent = Exclude<OverlayPanelSizing, \"menu\" | \"sm\" | \"md\" | \"lg\">;\n\nexport type OverlayPanelProps = Omit<useRender.ComponentProps<\"div\">, \"className\" | \"style\"> & {\n  /** Surface shadow depth (see `internal/surface`). */\n  elevation: SurfaceVariantProps[\"elevation\"];\n  /** Surface corner radius (see `internal/surface`). */\n  radius: SurfaceVariantProps[\"radius\"];\n  /**\n   * How the panel takes its width. `auto` is the content's width, never narrower than 192px, never\n   * wider than 384px or the room beside the anchor, and held while open so a filtering list does\n   * not reflow; it caps the list at 384px tall. `anchor` matches the trigger's width, grows only\n   * with its content up to the room beside the anchor, and caps the list at 288px tall. Omit for\n   * content width with no floor, no ceiling and no hold.\n   */\n  sizing?: OverlayPanelSizing;\n  /** Sticky content pinned above the scroll body (e.g. a `DropdownSearch`). */\n  header?: React.ReactNode;\n  /** Sticky content pinned below the scroll body (e.g. a `DropdownFooter`). */\n  footer?: React.ReactNode;\n};\n\nexport function OverlayPanel({\n  render,\n  elevation,\n  radius,\n  sizing,\n  header,\n  footer,\n  children,\n  ...props\n}: OverlayPanelProps) {\n  const holdRef = useHeldWidth(holdsWidth(sizing));\n  const defaultProps: useRender.ElementProps<\"div\"> = {\n    className: cx(surfaceVariants({ elevation, radius }), overlayPanelVariants({ sizing })),\n    children: (\n      <>\n        {header}\n        <ScrollArea orientation=\"vertical\">{children}</ScrollArea>\n        {footer}\n      </>\n    ),\n  };\n  return useRender({\n    defaultTagName: \"div\",\n    render,\n    ref: holdRef,\n    props: mergeProps(defaultProps, props),\n  });\n}\n"],"mappings":";;;;;;;;;AAoCA,MAAM,iBAAiB,GACrB,qGACA,kEACF;;;;;;;;;;;;;;;;;;;;;;AAuBA,MAAa,cAAc,WACzB,UAAU,QAAQ,WAAW;AAE/B,SAAS,aAAa,SAAiE;CACrF,MAAM,CAAC,SAAS,cAAc,MAAM,SAAgC,IAAI;CACxE,MAAM,sBAAsB;EAC1B,IAAI,CAAC,WAAW,WAAW,MAAM,OAAO,KAAA;EACxC,IAAI,OAAO;EACX,MAAM,aAAa;GAGjB,MAAM,QAAQ,QAAQ;GACtB,IAAI,QAAQ,MAAM;IAChB,OAAO;IACP,QAAQ,MAAM,YAAY,sBAAsB,GAAG,MAAM,GAAG;GAC9D;EACF;EACA,KAAK;EACL,MAAM,WAAW,IAAI,eAAe,IAAI;EACxC,SAAS,QAAQ,OAAO;EACxB,aAAa;GACX,SAAS,WAAW;GACpB,QAAQ,MAAM,eAAe,oBAAoB;EACnD;CACF,GAAG,CAAC,SAAS,OAAO,CAAC;CACrB,OAAO,UAAU,aAAa,KAAA;AAChC;AAEA,MAAM,uBAAuB,IAC3B,GAGE,yEAWA,oFACA,wCACA,8DACA,0DACA,gGACA,kGACF,GACA,EACE,UAAU,EASR,QAAQ;CACN,MAAM,GAAG,gBAAgB,4CAA4C;CACrE,QAAQ,GACN,qEACA,+DACF;;CAOA,MAAM,GAAG,gBAAgB,4CAA4C;;CAErE,IAAI,GAAG,gBAAgB,4CAA4C;;CAEnE,IAAI,GAAG,gBAAgB,4CAA4C;;CAEnE,IAAI,GAAG,gBAAgB,4CAA4C;AACrE,EACF,EACF,CACF;AA0BA,SAAgB,aAAa,EAC3B,QACA,WACA,QACA,QACA,QACA,QACA,UACA,GAAG,SACiB;CAYpB,OAAO,UAAU;EACf,gBAAgB;EAChB;EACA,KAdc,aAAa,WAAW,MAAM,CAcjC;EACX,OAAO,WAAW;GAblB,WAAW,GAAG,gBAAgB;IAAE;IAAW;GAAO,CAAC,GAAG,qBAAqB,EAAE,OAAO,CAAC,CAAC;GACtF,UACE,qBAAA,UAAA,EAAA,UAAA;IACG;IACD,oBAAC,YAAD;KAAY,aAAY;KAAY;IAAqB,CAAA;IACxD;GACD,EAAA,CAAA;EAOyB,GAAG,KAAK;CACvC,CAAC;AACH"}