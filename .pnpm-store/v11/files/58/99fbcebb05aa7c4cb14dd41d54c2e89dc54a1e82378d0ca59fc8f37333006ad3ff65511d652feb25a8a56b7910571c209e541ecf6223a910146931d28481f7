{"version":3,"file":"combobox-field.js","names":[],"sources":["../../../src/components/combobox-field/combobox-field.tsx"],"sourcesContent":["import * as React from \"react\";\n\nimport { FieldControlContent } from \"../../elements/field/field-control-content\";\nimport { FieldLabel } from \"../../elements/field/field-label\";\nimport { FieldLabelGroup } from \"../../elements/field/field-label-group\";\nimport { FieldLabelRequiredMarker } from \"../../elements/field/field-label-required-marker\";\nimport type { FieldSize } from \"../../elements/field/variants\";\nimport { useControllableState } from \"../../hooks/use-controllable-state\";\nimport {\n  Combobox,\n  ComboboxContent,\n  ComboboxEmpty,\n  ComboboxItem,\n  ComboboxList,\n  type ComboboxProps,\n  ComboboxSearch,\n  ComboboxSelectAll,\n  ComboboxSeparator,\n  ComboboxStickyList,\n  ComboboxTrigger,\n  type ComboboxVariant,\n} from \"../combobox\";\nimport { Field } from \"../field\";\nimport { FieldDescription } from \"../field/field-description\";\nimport { FieldHelperText } from \"../field/field-helper-text\";\n\nexport type { ComboboxVariant };\nexport type { FieldSize };\n\nexport type ComboboxFieldProps<Value = string> = Omit<\n  ComboboxProps<Value, true>,\n  \"children\" | \"items\" | \"multiple\" | \"onValueChange\"\n> & {\n  /**\n   * Frame look. `neutral` is the bordered field surface; `ghost` is borderless. Invalid on ghost\n   * has no trigger chrome — the danger cue is the helper text below.\n   *\n   * @default \"neutral\"\n   */\n  variant?: ComboboxVariant;\n  /** Supporting text shown below the label. */\n  description?: React.ReactNode;\n  /** Decorative trailing glyph inside the trigger. Omit it to show a chevron. */\n  trailing?: React.ReactNode;\n  /** Decorative leading element at the inline-start, e.g. `<Icon icon={Plus} tint=\"placeholder\" />`. */\n  icon?: React.ReactNode;\n  /** Message rendered when no item matches. */\n  empty: React.ReactNode;\n  /** Error text shown below the